# Copy to .env and fill in.
DATABASE_URL=
PORT=3000
USER_JWT_SECRET=change-me-user
ADMIN_JWT_SECRET=change-me-admin
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=admin123
# Local embedded Postgres location (used only when DATABASE_URL is empty)
PGLITE_PATH=./data/ghadi-pg

# Manual UPI
UPI_ID=
UPI_NAME=GHADI

# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
